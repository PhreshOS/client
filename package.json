{
  "name": "@phreshos/client",
  "version": "0.1.32",
  "description": "The SDK used by a Program's client endpoint.",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "author": "Zohayr SLILEH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhreshOS/client.git"
  },
  "bugs": {
    "url": "https://github.com/PhreshOS/client/issues"
  },
  "homepage": "https://github.com/PhreshOS/client#readme",
  "keywords": [
    "phreshos",
    "client",
    "sdk",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "node --run clean && tsc --noEmit false --outDir dist --rootDir source",
    "verify:completions": "node scripts/verify-completions.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "node --run check && node --run verify:completions && node --run build && node --run verify:package",
    "prepack": "node --run build"
  },
  "peerDependencies": {
    "@phreshos/core": "^0.1.36"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "devDependencies": {
    "@phreshos/core": "^0.1.36",
    "typescript": "^6.0.3"
  }
}
